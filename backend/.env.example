NODE_ENV=development
PORT=4000

# Local: the docker compose database. Production: the Supabase connection
# string (Project settings -> Database -> Connection string -> URI).
DATABASE_URL=postgres://ani:ani@localhost:5433/ani

# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=info

# At least 32 characters. Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-at-least-thirty-two-characters
SESSION_TTL_DAYS=30

# Optional. Product photos are disabled without these; everything else works.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=produce
